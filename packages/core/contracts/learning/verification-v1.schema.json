{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rickydata.org/schemas/learning-verification-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "accepted", "lessons"],
  "properties": {
    "version": { "const": 1 },
    "accepted": { "type": "boolean" },
    "lessons": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lessonIndex", "claims"],
        "properties": {
          "lessonIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
          "claims": {
            "type": "array",
            "maxItems": 48,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claimIndex", "supported"],
              "properties": {
                "claimIndex": { "type": "integer", "minimum": 0, "maximum": 47 },
                "supported": { "type": "boolean" },
                "reason": { "type": "string", "minLength": 1, "maxLength": 800 }
              }
            }
          }
        }
      }
    }
  }
}
